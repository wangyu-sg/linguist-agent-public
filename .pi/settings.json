{
  "theme": "dark",
  "defaultProvider": "opencode-go",
  "defaultModel": "qwen3.7-plus",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": false,
  "sessionDir": "sessions",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 1000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "httpIdleTimeoutMs": 300000,
  "websocketConnectTimeoutMs": 15000,
  "skills": [
    "./skills"
  ],
  "prompts": [
    "./prompts"
  ],
  "extensions": [
    "./extensions"
  ],
  "enableSkillCommands": true,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "packages": [
    "npm:pi-subagents@0.35.1",
    "npm:pi-docparser@3.0.1",
    "npm:@gotgenes/pi-permission-system@20.0.0",
    "npm:@juicesharp/rpiv-advisor@1.20.0"
  ]
}
