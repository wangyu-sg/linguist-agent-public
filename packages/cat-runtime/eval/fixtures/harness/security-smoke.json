{
  "schemaVersion": 1,
  "id": "harness-security-smoke",
  "description": "Synthetic offline harness security fixture. No network, no model, no credentials, no client text.",
  "projectId": "harness-security-smoke",
  "cases": [
    {
      "id": "tool-source-web-search",
      "kind": "tool_source",
      "toolName": "web_search",
      "expectedSource": "pi-inherited"
    },
    {
      "id": "tool-source-write",
      "kind": "tool_source",
      "toolName": "write",
      "expectedSource": "builtin"
    },
    {
      "id": "tool-source-proposal-create",
      "kind": "tool_source",
      "toolName": "proposal_create",
      "expectedSource": "cat-native"
    },
    {
      "id": "data-write-blocked",
      "kind": "data_write_attempt",
      "toolName": "write",
      "input": {
        "path": "data/projects/harness-security-smoke/batches/b1/batch.json"
      },
      "expected": "blocked"
    },
    {
      "id": "scratch-write-allowed",
      "kind": "data_write_attempt",
      "toolName": "write",
      "input": {
        "path": "scratch/output.txt"
      },
      "expected": "allowed"
    },
    {
      "id": "novel-write-verb-blocked",
      "kind": "data_write_attempt",
      "toolName": "multi_edit",
      "input": {
        "file_path": "data/projects/harness-security-smoke/batches/b1/batch.json"
      },
      "expected": "blocked"
    },
    {
      "id": "patch-verb-blocked",
      "kind": "data_write_attempt",
      "toolName": "apply_patch",
      "input": {
        "edits": [
          {
            "file_path": "data/projects/harness-security-smoke/glossary.json"
          }
        ]
      },
      "expected": "blocked"
    },
    {
      "id": "data-read-allowed",
      "kind": "data_write_attempt",
      "toolName": "read",
      "input": {
        "file_path": "data/projects/harness-security-smoke/batches/b1/batch.json"
      },
      "expected": "allowed"
    },
    {
      "id": "advisory-web-result",
      "kind": "advisory_result",
      "toolName": "web_search",
      "contentText": "Synthetic public reference excerpt.",
      "expectedCitable": false
    },
    {
      "id": "sandbox-exact-hosts-allowed",
      "kind": "sandbox_egress",
      "domains": ["api.deepseek.com", "api.tavily.com"],
      "expected": "allowed"
    },
    {
      "id": "sandbox-wildcard-denied",
      "kind": "sandbox_egress",
      "domains": ["*.example.com"],
      "expected": "denied"
    },
    {
      "id": "sandbox-null-byte-denied",
      "kind": "sandbox_egress",
      "domains": ["example.com%00.attacker.test"],
      "expected": "denied"
    },
    {
      "id": "sandbox-credential-deny-read",
      "kind": "sandbox_fs_guard",
      "expectedDenyRead": ["~/.agent-reach", "~/.ssh", "~/.aws"],
      "expectedDenyWriteData": true
    },
    {
      "id": "secret-env-scrub",
      "kind": "secret_env_scrub",
      "inputEnv": {
        "PATH": "/usr/bin",
        "HOME": "/Users/test",
        "TAVILY_API_KEY": "synthetic-secret",
        "SESSION_COOKIE": "synthetic-secret",
        "PLAIN_VALUE": "ok"
      },
      "expectedRemoved": ["TAVILY_API_KEY", "SESSION_COOKIE"],
      "expectedRetained": ["PATH", "HOME", "PLAIN_VALUE"]
    },
    {
      "id": "mock-evidence-promotion",
      "kind": "evidence_promotion",
      "advisoryToolName": "web_search",
      "catToolName": "proposal_create",
      "evidenceSource": "synthetic:evidence:1",
      "excerpt": "Synthetic excerpt recorded through a CAT evidence path.",
      "expectedBeforeCitable": false,
      "expectedAfterCitable": true
    }
  ]
}
