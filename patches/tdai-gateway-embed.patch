@@ -392,0 +398,39 @@ export class TdaiGateway {
+  private async handleEmbed(req: http.IncomingMessage, res: http.ServerResponse): Promise<void> {
+    const body = await parseJsonBody<EmbedRequest>(req);
+    const texts = body.texts ?? (typeof body.text === "string" ? [body.text] : []);
+    if (!Array.isArray(texts) || texts.some((value) => typeof value !== "string")) {
+      sendError(res, 400, "Missing or invalid required field: text or texts");
+      return;
+    }
+
+    const service = this.core.getEmbeddingService();
+    if (!service) {
+      sendError(res, 503, "Embedding service unavailable");
+      return;
+    }
+
+    const info = service.getProviderInfo();
+    const base: Omit<EmbedResponse, "vectors"> = {
+      provider: info.provider,
+      model: info.model,
+      dimensions: service.getDimensions(),
+      ready: service.isReady(),
+      count: texts.length,
+    };
+
+    if (!service.isReady()) {
+      sendJson(res, 503, { ...base, vectors: [] } satisfies EmbedResponse);
+      return;
+    }
+
+    const vectors = texts.length
+      ? await service.embedBatch(texts, body.timeout_ms ? { timeoutMs: body.timeout_ms } : undefined)
+      : [];
+
+    sendJson(res, 200, {
+      ...base,
+      ready: true,
+      vectors: vectors.map((vector) => Array.from(vector)),
+    } satisfies EmbedResponse);
+  }
+
