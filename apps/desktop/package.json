{
  "name": "@linguist-agent/desktop",
  "productName": "Linguist Agent",
  "version": "2.32.7",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "node scripts/package-macos.mjs",
    "verify": "node scripts/verify-macos.mjs",
    "verify:signing-stability": "node scripts/verify-signing-stability.mjs",
    "runtime:prepare-native-capabilities": "node scripts/prepare-native-capabilities.mjs",
    "runtime:acceptance": "node scripts/electron-acceptance-runtime.mjs",
    "acceptance:real-pi": "node scripts/electron-real-pi-slice.mjs",
    "acceptance:real-pi-lifecycle": "node scripts/electron-real-pi-lifecycle.mjs",
    "acceptance:real-pi-restart": "node scripts/electron-real-pi-restart.mjs",
    "run": "npm run package && node scripts/run-macos.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.* src/renderer/composer/*.test.* src/renderer/conversation/*.test.* && node --import tsx --test tests/electron-acceptance-activity.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.6",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/asar": "4.2.0",
    "@electron/packager": "20.0.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
