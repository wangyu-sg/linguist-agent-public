{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguist-agent.local/contracts/task-workspace-snapshot.v1.schema.json",
  "title": "Linguist Agent Task Workspace Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "eventCursor",
    "projectedAt",
    "runs",
    "agentThreads",
    "activities",
    "artifacts",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "task": {
      "$ref": "./task-workspace-common.v1.schema.json#/$defs/task"
    },
    "activeRunId": {
      "$ref": "./task-workspace-common.v1.schema.json#/$defs/nullableString"
    },
    "eventCursor": {
      "$ref": "./task-workspace-common.v1.schema.json#/$defs/nonEmptyString"
    },
    "projectedAt": {
      "$ref": "./task-workspace-common.v1.schema.json#/$defs/timestamp"
    },
    "usage": {
      "$ref": "./task-workspace-common.v1.schema.json#/$defs/usage"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "./task-workspace-common.v1.schema.json#/$defs/run"
      }
    },
    "agentThreads": {
      "type": "array",
      "items": {
        "$ref": "./task-workspace-common.v1.schema.json#/$defs/thread"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "./task-workspace-common.v1.schema.json#/$defs/activity"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "./task-workspace-common.v1.schema.json#/$defs/artifact"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "./task-workspace-common.v1.schema.json#/$defs/decision"
      }
    }
  }
}
