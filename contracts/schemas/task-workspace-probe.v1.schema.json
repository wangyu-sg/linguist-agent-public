{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguist-agent.local/contracts/task-workspace-probe.v1.schema.json",
  "title": "Linguist Agent Task Workspace Probe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "taskId",
    "taskStatus",
    "taskUpdatedAt",
    "eventCursor",
    "projectedAt",
    "activeRunId",
    "activeRunStatus",
    "activeRunUpdatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/nonEmptyString" },
    "taskId": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/nonEmptyString" },
    "taskStatus": {
      "enum": ["draft", "active", "awaiting_input", "stopped", "failed", "complete", "archived"]
    },
    "taskUpdatedAt": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/timestamp" },
    "eventCursor": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/nonEmptyString" },
    "projectedAt": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/timestamp" },
    "activeRunId": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/nullableString" },
    "activeRunStatus": {
      "type": ["string", "null"],
      "enum": ["pending", "active", "awaiting_input", "waiting", "stopping", "stopped", "failed", "stale", "complete", null]
    },
    "activeRunUpdatedAt": { "$ref": "./task-workspace-common.v1.schema.json#/$defs/nullableTimestamp" }
  }
}
