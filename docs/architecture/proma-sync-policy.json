{
  "schemaVersion": 1,
  "baselineFile": "docs/architecture/proma-baseline.json",
  "rules": [
    {
      "patterns": [
        "apps/electron/src/renderer/components/agent/AgentView.tsx",
        "apps/electron/src/renderer/components/agent/SidePanel.tsx",
        "apps/electron/src/renderer/components/app-shell/AppShell.tsx"
      ],
      "policy": "host-seam",
      "owner": "renderer-host"
    },
    {
      "patterns": ["apps/electron/package.json"],
      "policy": "overlay"
    },
    {
      "patterns": [
        "apps/electron/src/main/lib/agent-orchestrator.ts",
        "apps/electron/src/main/ipc.ts",
        "apps/electron/src/preload/index.ts",
        "apps/electron/src/main/lib/agent-collaboration-tools.ts",
        "apps/electron/src/main/lib/adapters/pi-builtin-tools.ts",
        "apps/electron/src/main/lib/adapters/pi-agent-adapter.ts"
      ],
      "policy": "host-seam",
      "owner": "codex-main-host"
    },
    {
      "patterns": [
        "packages/core/package.json",
        "packages/shared/package.json",
        "packages/session-core/package.json",
        "packages/ui/package.json",
        "packages/shared/src/types/feishu.ts",
        "apps/electron/src/main/lib/chat-tool-config.ts",
        "apps/electron/src/main/lib/adapters/pi-mcp-tools.ts",
        "apps/electron/src/renderer/components/agent/AgentPlaceholder.tsx"
      ],
      "policy": "take-upstream"
    },
    {
      "patterns": [
        "README.md",
        "README.en.md",
        "AGENTS.md",
        "NOTICE.md",
        "ATTRIBUTION.md",
        "THIRD_PARTY_NOTICES.md",
        "packages/linguist-**",
        "resources/linguist-**",
        "apps/electron/src/main/lib/linguist/**",
        "apps/electron/src/renderer/host/**",
        "apps/electron/src/renderer/features/linguist/**",
        "apps/electron/default-skills/cultural-lqa/**",
        "apps/electron/default-skills/localization-readiness/**",
        "apps/electron/default-skills/release-lqa/**",
        "apps/electron/default-skills/terminology-candidate-mining/**",
        "apps/electron/default-skills/translator-brief/**",
        "apps/electron/default-skills/agent-collaboration/SKILL.md",
        "apps/electron/default-skills/session-cleaner/SKILL.md",
        "apps/electron/default-skills/session-cleaner/references/cli-usage.md",
        "apps/electron/default-skills/tool-builder/SKILL.md",
        "apps/electron/resources/macos-install-help.txt",
        "apps/electron/resources/generate-icons.sh",
        "apps/electron/resources/icon-source.png",
        "apps/electron/resources/icon.icns",
        "apps/electron/resources/icon.ico",
        "apps/electron/resources/icon.png",
        "apps/electron/resources/icon.svg",
        "apps/electron/resources/proma-logos/icon.svg",
        "apps/electron/resources/proma-logos/iconTemplate.png",
        "apps/electron/resources/proma-logos/iconTemplate@2x.png",
        "apps/electron/resources/proma-logos/iconTemplate@3x.png",
        "apps/electron/resources/tutorial.md"
      ],
      "policy": "keep-la"
    },
    {
      "patterns": [
        "bun.lock",
        "docs/architecture/proma-baseline.json",
        "docs/architecture/proma-touchpoints.json",
        "docs/architecture/UPSTREAM_BASELINE.md",
        "apps/electron/src/renderer/lib/linguist-build-metadata.ts"
      ],
      "policy": "regenerate"
    },
    {
      "patterns": [
        "apps/electron/native/eventkit/macos-eventkit-addon.mm",
        "apps/electron/scripts/build-cli.ts",
        "apps/electron/scripts/build-eventkit-native.ts",
        "apps/electron/scripts/run-electron-builder.ts",
        "apps/electron/src/main/agent-status-hover-window.ts",
        "apps/electron/src/main/lib/agent-island-navigation-policy.ts",
        "apps/electron/src/main/lib/agent-model-selection.ts",
        "apps/electron/src/main/lib/browser-controller.ts",
        "apps/electron/src/main/lib/detached-preview-window.ts",
        "apps/electron/src/main/lib/mac-eventkit-native-addon.ts",
        "apps/electron/src/main/lib/mcp-oauth-service.ts",
        "apps/electron/src/main/lib/planning-native-sync-coordinator.ts",
        "apps/electron/src/main/lib/planning-native-sync-service.ts",
        "apps/electron/src/main/lib/quick-task-window.ts",
        "apps/electron/src/main/lib/test/electron-mock.ts",
        "apps/electron/src/main/lib/todo-agent-start.ts",
        "apps/electron/src/main/lib/vault-service.ts",
        "apps/electron/src/main/lib/voice-dictation-output-result.ts",
        "apps/electron/src/main/lib/voice-dictation-window.ts",
        "apps/electron/src/main/lib/workspace-memory-window.ts",
        "apps/electron/src/renderer/components/agent-skills/IntegrationCatalog.tsx",
        "apps/electron/src/renderer/components/agent-skills/integration-catalog.ts",
        "apps/electron/src/renderer/components/agent-skills/useAgentSkillsData.ts",
        "apps/electron/src/renderer/components/ai-elements/conversation.tsx",
        "apps/electron/src/renderer/components/chat/ChatHeader.tsx",
        "apps/electron/src/renderer/components/chat/ChatInput.tsx",
        "apps/electron/src/renderer/components/chat/ContextSettingsPopover.tsx",
        "apps/electron/src/renderer/components/chat/ModelSelector.tsx",
        "apps/electron/src/renderer/components/chat/PromptEditorSidebar.tsx",
        "apps/electron/src/renderer/components/chat/ToolSelectorPopover.tsx",
        "apps/electron/src/renderer/components/file-browser/FileBrowser.tsx",
        "apps/electron/src/renderer/components/file-browser/file-browser-roots.ts",
        "apps/electron/src/renderer/components/file-browser/file-browser-load-state.ts",
        "apps/electron/src/renderer/components/tabs/tab-bar-action-layout.ts",
        "apps/electron/src/renderer/components/ui/sheet.tsx",
        "apps/electron/src/renderer/lib/window-titlebar-layout.ts",
        "packages/ui/src/code-block/CodeBlock.tsx",
        "apps/electron/src/renderer/components/ai-elements/file-path-chip-utils.ts",
        "apps/electron/src/renderer/components/ai-elements/file-path-chip.tsx",
        "apps/electron/src/renderer/components/diff/DetachedPreviewApp.tsx",
        "apps/electron/src/renderer/components/diff/DiffChangesList.tsx",
        "apps/electron/src/renderer/components/diff/DiffTabContent.tsx",
        "apps/electron/src/renderer/components/diff/PreviewContentErrorBoundary.tsx",
        "apps/electron/src/renderer/components/diff/markdown-scroll-restore.ts",
        "apps/electron/src/renderer/components/ui/content-error-boundary.tsx",
        "apps/electron/src/renderer/components/vault/VaultContentErrorBoundary.tsx",
        "apps/electron/src/renderer/components/vault/VaultView.tsx",
        "apps/electron/src/renderer/components/vault/vault-editor-lifecycle.ts",
        "apps/electron/src/renderer/components/vault/vault-sidebar-layout.ts",
        "apps/electron/src/renderer/lib/session-file-changes.ts",
        "apps/electron/src/renderer/lib/session-reference-drag.ts",
        "apps/electron/src/renderer/lib/stop-generation-target.ts"
      ],
      "policy": "manual",
      "owner": "upstream-maintenance"
    },
    {
      "patterns": ["**"],
      "policy": "manual"
    }
  ]
}
