{
  "schemaVersion": 1,
  "rules": [
    {
      "classification": "la-owned",
      "paths": [
        "packages/linguist-**",
        "resources/linguist-**",
        "apps/electron/src/main/lib/linguist/**",
        "apps/electron/src/renderer/features/linguist/**",
        "apps/electron/default-skills/cultural-lqa/**",
        "apps/electron/default-skills/localization-readiness/**",
        "apps/electron/default-skills/release-lqa/**",
        "apps/electron/default-skills/terminology-candidate-mining/**",
        "apps/electron/default-skills/translator-brief/**"
      ],
      "reason": "Linguist CAT、Workbench、Role 或 Tool 的自有实现"
    },
    {
      "classification": "generated",
      "paths": [
        "bun.lock",
        "docs/architecture/proma-baseline.json",
        "docs/architecture/proma-touchpoints.json",
        "docs/architecture/UPSTREAM_BASELINE.md",
        "apps/electron/src/renderer/lib/linguist-build-metadata.ts"
      ],
      "reason": "由同步或构建流程重新生成"
    },
    {
      "classification": "la-owned",
      "paths": [
        "docs/**",
        "tests/**",
        "scripts/**",
        "config/**",
        "AGENTS.md",
        "CURRENT_FACTS.md",
        "CURRENT_FACTS_SIMPLE.md",
        "TODO.md"
      ],
      "reason": "Linguist Agent 的工程规则、验证、同步工具或事实文档"
    },
    {
      "classification": "product-fork",
      "paths": [
        "apps/cli/**",
        "apps/electron/electron-builder.yml",
        "apps/electron/resources/**",
        "apps/electron/src/main/index.ts",
        "apps/electron/src/main/lib/config-paths.ts",
        "apps/electron/src/main/lib/electron-user-data-path.ts",
        "apps/electron/default-skills/**",
        ".github/workflows/**",
        "package.json",
        "README.md",
        "README.en.md",
        "NOTICE.md",
        "ATTRIBUTION.md",
        "THIRD_PARTY_NOTICES.md"
      ],
      "reason": "独立产品身份、数据根、资源或发行合同"
    },
    {
      "classification": "host-seam",
      "paths": [
        "apps/electron/src/main/ipc.ts",
        "apps/electron/src/preload/index.ts",
        "apps/electron/src/main/lib/agent-orchestrator.ts",
        "apps/electron/src/main/lib/agent-collaboration-tools.ts",
        "apps/electron/src/main/lib/adapters/pi-agent-adapter.ts"
      ],
      "reason": "Linguist 能力接入 Proma 原生运行时的稳定 Host Seam"
    }
  ],
  "overrides": [
    {
      "file": "packages/shared/src/types/feishu.ts",
      "classification": "cosmetic-drift",
      "reason": "仅持久化路径注释不同"
    },
    {
      "file": "apps/electron/src/main/lib/chat-tool-config.ts",
      "classification": "cosmetic-drift",
      "reason": "仅持久化路径注释不同"
    },
    {
      "file": "apps/electron/default-skills/agent-collaboration/SKILL.md",
      "classification": "product-fork",
      "reason": "默认 Skill 必须指向 Linguist Agent 的实际会话数据根"
    },
    {
      "file": "apps/electron/default-skills/session-cleaner/SKILL.md",
      "classification": "product-fork",
      "reason": "默认 Skill 必须指向 Linguist Agent 的实际会话数据根"
    },
    {
      "file": "apps/electron/default-skills/session-cleaner/references/cli-usage.md",
      "classification": "product-fork",
      "reason": "CLI 使用说明必须描述 Linguist Agent 的实际会话数据根"
    },
    {
      "file": "apps/electron/default-skills/tool-builder/SKILL.md",
      "classification": "product-fork",
      "reason": "默认 Skill 必须指向 Linguist Agent 的实际工具配置根"
    }
  ]
}
