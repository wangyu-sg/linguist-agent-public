{
  "name": "proma",
  "version": "0.1.1",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/electron' dev",
    "electron:dev": "bun run --filter='@proma/electron' dev",
    "electron:build": "bun run --filter='@proma/electron' build",
    "electron:start": "bun run --filter='@proma/electron' start",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "check:boundaries": "bun test tests/upstream-boundary.test.ts",
    "sync:impact": "node scripts/proma-sync-impact.mjs",
    "license:scan": "bun scripts/license-scan.mjs",
    "license:check": "bun scripts/license-scan.mjs --check"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dompurify": "^3.4.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.201",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.82.1": "patches/@earendil-works%2Fpi-ai@0.82.1.patch",
    "@earendil-works/pi-coding-agent@0.82.1": "patches/@earendil-works%2Fpi-coding-agent@0.82.1.patch"
  }
}
